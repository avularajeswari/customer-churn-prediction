
# ============================================
# TASK 2: FEATURES AND BASELINE MODELS
# ============================================

# 1. IMPORT LIBRARIES

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
import joblib

from sklearn.model_selection import StratifiedKFold, cross_validate
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier

warnings.filterwarnings('ignore')


# ============================================
# 2. LOAD DATASET
# ============================================

df = pd.read_csv(
    "Customer Churn/WA_Fn-UseC_-Telco-Customer-Churn.csv"
)

print("Dataset Loaded Successfully!")

print(df.head())
print("Dataset Shape:", df.shape)


# ============================================
# 3. DATA CLEANING
# ============================================

df['TotalCharges'] = pd.to_numeric(
    df['TotalCharges'],
    errors='coerce'
)

# Remove customer ID
df.drop(columns=['customerID'], inplace=True)

print("\nMissing Values:")
print(df.isnull().sum())

print("\nDataset Information:")
df.info()


# ============================================
# 4. FEATURE ENGINEERING
# ============================================

# Feature 1: Tenure Groups

df['TenureGroup'] = pd.cut(
    df['tenure'],
    bins=[-1, 12, 24, 48, 72],
    labels=['New', 'Medium', 'Long', 'Very Long']
)


# Feature 2: Monthly Spend Category

df['MonthlySpendCategory'] = pd.cut(
    df['MonthlyCharges'],
    bins=[0, 35, 70, 100, float('inf')],
    labels=['Low', 'Medium', 'High', 'Very High']
)


# Feature 3: Number of Services

service_columns = [
    'PhoneService',
    'MultipleLines',
    'OnlineSecurity',
    'OnlineBackup',
    'DeviceProtection',
    'TechSupport',
    'StreamingTV',
    'StreamingMovies'
]

df['ServiceCount'] = df[service_columns].apply(
    lambda row: sum(value == 'Yes' for value in row),
    axis=1
)


# Feature 4: Spend Per Month

df['SpendPerMonth'] = (
    df['TotalCharges'] /
    df['tenure'].replace(0, np.nan)
)


# Feature 5: Tenure Years

df['TenureYears'] = df['tenure'] / 12


# Feature 6: Senior Citizen

df['IsSenior'] = df['SeniorCitizen']


print("\n6 New Features Created Successfully!")

print(df.head())


# ============================================
# 5. SEPARATE FEATURES AND TARGET
# ============================================

X = df.drop(columns=['Churn'])

y = df['Churn'].map({
    'Yes': 1,
    'No': 0
})

print("\nFeatures Shape:", X.shape)
print("Target Shape:", y.shape)

print("\nTarget Distribution:")
print(y.value_counts())


# ============================================
# 6. IDENTIFY NUMERICAL AND CATEGORICAL FEATURES
# ============================================

numeric_features = X.select_dtypes(
    include=['number']
).columns.tolist()

categorical_features = X.select_dtypes(
    include=['object', 'category', 'bool']
).columns.tolist()

print("\nNumerical Features:")
print(numeric_features)

print("\nCategorical Features:")
print(categorical_features)


# ============================================
# 7. BUILD COLUMNTRANSFORMER
# ============================================

# Numerical preprocessing

numeric_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='median')),
    ('scaler', StandardScaler())
])


# Categorical preprocessing

categorical_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='most_frequent')),
    ('onehot', OneHotEncoder(handle_unknown='ignore'))
])


# Combine preprocessing

preprocessor = ColumnTransformer(
    transformers=[
        ('num', numeric_transformer, numeric_features),
        ('cat', categorical_transformer, categorical_features)
    ]
)

print("\nColumnTransformer Created Successfully!")


# ============================================
# 8. LOGISTIC REGRESSION PIPELINE
# ============================================

logistic_pipeline = Pipeline(steps=[
    ('preprocessor', preprocessor),
    ('classifier', LogisticRegression(
        max_iter=1000,
        random_state=42
    ))
])

print("Logistic Regression Pipeline Created!")


# ============================================
# 9. RANDOM FOREST PIPELINE
# ============================================

random_forest_pipeline = Pipeline(steps=[
    ('preprocessor', preprocessor),
    ('classifier', RandomForestClassifier(
        n_estimators=200,
        max_depth=None,
        random_state=42,
        n_jobs=-1
    ))
])

print("Random Forest Pipeline Created!")


# ============================================
# 10. 5-FOLD CROSS VALIDATION
# ============================================

cv = StratifiedKFold(
    n_splits=5,
    shuffle=True,
    random_state=42
)


# Evaluation metrics

scoring = {
    'roc_auc': 'roc_auc',
    'f1': 'f1'
}


# Logistic Regression Cross Validation

print("\nEvaluating Logistic Regression...")

logistic_scores = cross_validate(
    logistic_pipeline,
    X,
    y,
    cv=cv,
    scoring=scoring,
    n_jobs=-1
)


# Random Forest Cross Validation

print("\nEvaluating Random Forest...")

rf_scores = cross_validate(
    random_forest_pipeline,
    X,
    y,
    cv=cv,
    scoring=scoring,
    n_jobs=-1
)

print("\n5-Fold Cross Validation Completed!")


# ============================================
# 11. CREATE RESULTS TABLE
# ============================================

results = pd.DataFrame({
    'Model': [
        'Logistic Regression',
        'Random Forest'
    ],

    'CV ROC-AUC': [
        logistic_scores['test_roc_auc'].mean(),
        rf_scores['test_roc_auc'].mean()
    ],

    'CV F1': [
        logistic_scores['test_f1'].mean(),
        rf_scores['test_f1'].mean()
    ]
})


# Round results to 2 decimal places

results = results.round(2)


print("\n===================================")
print(" FEATURES AND BASELINE MODEL RESULTS")
print("===================================")

print(results.to_string(index=False))


# ============================================
# 12. SAVE RESULTS TABLE
# ============================================

results.to_csv(
    'baseline_model_results.csv',
    index=False
)

print("\nResults table saved successfully!")


# ============================================
# 13. VISUALIZE MODEL PERFORMANCE
# ============================================

ax = results.set_index('Model').plot(
    kind='bar',
    figsize=(10, 5),
    color=['skyblue', 'orange']
)

plt.title('Baseline Model Performance')
plt.ylabel('Score')
plt.xlabel('Models')
plt.ylim(0, 1)
plt.xticks(rotation=0)
plt.legend(title='Metrics')
plt.tight_layout()

plt.savefig(
    'baseline_model_comparison.png',
    dpi=300
)

plt.show()


# ============================================
# 14. TRAIN FINAL MODELS
# ============================================

logistic_pipeline.fit(X, y)

random_forest_pipeline.fit(X, y)

print("\nBoth Models Trained Successfully!")


# ============================================
# 15. SAVE TRAINED MODELS
# ============================================

joblib.dump(
    logistic_pipeline,
    'logistic_regression_model.pkl'
)

joblib.dump(
    random_forest_pipeline,
    'random_forest_model.pkl'
)

print("\nModels Saved Successfully!")


# ============================================
# TASK 2 COMPLETED
# ============================================

print("\n===================================")
print("TASK 2 COMPLETED SUCCESSFULLY!")
print("===================================")
